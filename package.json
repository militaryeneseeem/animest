{
  "name": "animest",
  "private": true,
  "version": "0.1.0",
  "description": "Production-grade anime discovery, community, and AI recommendation platform.",
  "packageManager": "pnpm@6.35.1",
  "engines": {
    "node": "24.x",
    "pnpm": "6.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "prisma:generate": "pnpm --filter @animest/database prisma:generate",
    "prisma:migrate": "pnpm --filter @animest/database prisma:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.8",
    "typescript": "^5.7.2"
  }
}
